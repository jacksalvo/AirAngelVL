<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_aspect_ratio"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/settings_image_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_saved_image"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/aspect_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radio_aspect_fullscreen"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_aspect_fullscreen"
            android:textColor="@android:color/white" />

        <RadioButton
            android:id="@+id/radio_aspect_16_9"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_aspect_16_9"
            android:textColor="@android:color/white" />

        <RadioButton
            android:id="@+id/radio_aspect_5_4"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_aspect_5_4"
            android:textColor="@android:color/white" />

        <RadioButton
            android:id="@+id/radio_aspect_4_3"
            android:minHeight="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_aspect_4_3"
            android:textColor="@android:color/white" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_image_tuning"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_brightness"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/value_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/value_brightness_default"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_brightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="-100"
        android:valueTo="100"
        android:stepSize="1"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_contrast"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/value_contrast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/value_percent_default"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_contrast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_saturation"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/value_saturation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/value_percent_default"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_saturation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_reset_image"
            style="@style/Widget.AirAngel.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_reset_image" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

